# PostgreSQL (required for Vercel / production)
# Free options: Neon (https://neon.tech), Vercel Postgres, Supabase
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/flashcards?sslmode=require"
# Example local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flashcards?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flashcards?schema=public"

# NextAuth — set NEXTAUTH_URL to your public site URL in production
# (If unset on Vercel, the app falls back to https://$VERCEL_URL)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
