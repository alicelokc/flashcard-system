# Local SQLite (dev). For production (Vercel/Neon), use PostgreSQL and set
# provider = "postgresql" in prisma/schema.prisma
# DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flashcards?schema=public"
DATABASE_URL="file:./dev.db"

# NextAuth — set NEXTAUTH_URL to your public site URL in production
# (If unset on Vercel, the app falls back to https://$VERCEL_URL)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (NextAuth Google provider)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated teacher emails (case-insensitive). Everyone else is STUDENT.
# Required for teacher access — leave empty and all Google users are students.
TEACHER_EMAILS="you@example.com"
